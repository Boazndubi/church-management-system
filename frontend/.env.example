 # API Configuration
VITE_API_BASE_URL=http://localhost:5000/api

# Application
VITE_APP_NAME=Church Management System
VITE_APP_VERSION=1.0.0

# Features
VITE_ENABLE_MPESA=true
VITE_ENABLE_BANK_INTEGRATION=true
VITE_ENABLE_WHATSAPP=true

# M-Pesa Configuration
VITE_MPESA_MERCHANT_CODE=your_merchant_code 

# Bank Integration
VITE_BANK_CODE=your_bank_code

# WhatsApp
VITE_WHATSAPP_PHONE=254712345678

# Analytics (Optional)
VITE_ANALYTICS_ID=your_analytics_id

# Environment
VITE_ENV=development 
