# Application
NODE_ENV=development
PORT=5000
APP_NAME=Church Management System

# Database (Local PostgreSQL)
DATABASE_URL=postgresql://postgres:password123@localhost:5432/church_management_db

# JWT Authentication
JWT_SECRET=dev_super_secret_jwt_key_12345
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# M-Pesa Configuration (Test/Sandbox)
MPESA_CONSUMER_KEY=sandbox_key_123
MPESA_CONSUMER_SECRET=sandbox_secret_123
MPESA_PASSKEY=sandbox_passkey
MPESA_ACCOUNT_REFERENCE=Church Account
MPESA_PHONE_NUMBER=254712345678

# Bank API Configuration
BANK_API_KEY=test_bank_key
BANK_API_SECRET=test_bank_secret

# WhatsApp Configuration
WHATSAPP_BUSINESS_ACCOUNT_ID=test_account_id
WHATSAPP_PHONE_NUMBER_ID=test_phone_id
WHATSAPP_API_TOKEN=test_token

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads  
