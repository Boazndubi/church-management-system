# Application
NODE_ENV=development
PORT=5000
APP_NAME=Church Management System

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/church_management_db

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Email Configuration (Optional - for sending emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# M-Pesa Configuration
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_ACCOUNT_REFERENCE=Church Account
MPESA_PHONE_NUMBER=254712345678

# Bank API Configuration
BANK_API_KEY=your_bank_api_key
BANK_API_SECRET=your_bank_api_secret

# WhatsApp Configuration
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_account_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_TOKEN=your_whatsapp_api_token

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads  
